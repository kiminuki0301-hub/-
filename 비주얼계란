
<!doctype html><html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>달걀 프라이와 기름의 궁합</title><meta name="description" content="달걀 6개와 오일 6개가 만나 달걀 프라이가 되는 인터랙티브 비주얼뉴스"><style>:root{--ink:#171717;--paper:#f5efe5;--dark:#101214;--yolk:#efad19;--cream:#fff9ee;--good:#59774d;--warn:#9d473c;--muted:#747675}*{box-sizing:border-box}html{scroll-behavior:smooth;background:#111}body{margin:0;background:var(--paper);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans KR","Apple SD Gothic Neo",Arial,sans-serif;word-break:keep-all}.progress{position:fixed;z-index:500;left:0;top:0;height:4px;width:0;background:var(--yolk)}img{display:block;max-width:100%}.sticky{position:sticky;top:0;height:100svh;overflow:hidden}.hero{height:135svh;position:relative}.hero .sticky{background:#111}.hero img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 54%;filter:brightness(.76)}.hero .shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.08),rgba(0,0,0,.74))}.hero-copy{position:absolute;z-index:3;left:6vw;bottom:8vh;width:min(760px,88vw);color:#fff}.kicker{font-size:.78rem;font-weight:900;letter-spacing:.13em;color:#f0b846}.hero h1{font-size:clamp(3rem,7vw,6.8rem);line-height:.95;letter-spacing:-.06em;margin:.5rem 0 1rem}.hero p{font-size:clamp(1.05rem,2vw,1.4rem);line-height:1.75;margin:0}.story{height:215svh;position:relative}.story .sticky{background:#111}.story-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:brightness(.58) saturate(.9);transform:scale(1.03)}.story-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.06),rgba(0,0,0,.7))}.story-card{position:absolute;z-index:5;left:50%;bottom:-38vh;transform:translateX(-50%);width:min(780px,90vw);padding:clamp(22px,3vw,38px);border-radius:20px;background:rgba(255,255,255,.95);box-shadow:0 22px 70px rgba(0,0,0,.26);opacity:0}.story-card .eyebrow{font-size:.75rem;font-weight:900;letter-spacing:.12em;color:#8c6318}.story-card h2{font-size:clamp(2.1rem,5vw,4.5rem);line-height:1.04;letter-spacing:-.05em;margin:.45rem 0 1rem}.story-card p{font-size:clamp(1rem,1.65vw,1.22rem);line-height:1.8;margin:.75rem 0;color:#3c4143}.story-card strong{color:#a03c34}.pairs{height:720svh;position:relative;background:#0b0c0e}.pair-stage{position:sticky;top:0;height:100svh;overflow:hidden;background:radial-gradient(circle at 50% 64%,#49351f,#17130f 55%,#080706);color:#fff}.pair-head{position:absolute;z-index:20;left:5vw;top:5vh;width:min(700px,78vw)}.pair-head h2{font-size:clamp(2.3rem,5vw,4.9rem);line-height:.98;letter-spacing:-.05em;margin:.35rem 0 .8rem}.pair-head p{margin:0;max-width:620px;color:#ddd3c2;line-height:1.7}.scene-count{position:absolute;right:5vw;top:6vh;z-index:20;color:#f1bd55;font-family:Georgia,serif;font-size:1.1rem}.pan{position:absolute;left:50%;bottom:-4%;transform:translateX(-50%);width:min(980px,94vw);height:49vh;border-radius:50% 50% 0 0;overflow:hidden;z-index:2;box-shadow:0 -20px 80px rgba(0,0,0,.75)}.pan img{width:100%;height:100%;object-fit:cover;object-position:center 55%;filter:brightness(.38) saturate(.55) blur(1px);transform:scale(1.02);transition:filter 1.1s,transform 4s,opacity .35s}.pair-stage.frying .pan img{filter:brightness(1.03) saturate(1.12) blur(0);transform:scale(1.1)}.egg{position:absolute;z-index:10;top:39%;width:min(180px,18vw);opacity:0;filter:drop-shadow(0 17px 14px rgba(0,0,0,.5));transform-origin:50% 50%}.bottle{position:absolute;z-index:9;top:22%;width:min(150px,13vw);height:37vh;opacity:0;border:3px solid rgba(255,255,255,.2);border-radius:28px 28px 16px 16px;background:linear-gradient(180deg,#f5e1ad 0,#dab45d 19%,#b07122 70%,#663810 100%);box-shadow:0 24px 28px rgba(0,0,0,.38)}.bottle:before{content:"";position:absolute;left:50%;top:-10%;transform:translateX(-50%);width:35%;height:12%;border-radius:9px 9px 0 0;background:#a56e1d}.bottle-label{position:absolute;left:13%;right:13%;top:40%;padding:.55rem .3rem;border-radius:8px;background:#f8f0dc;color:#231b13;text-align:center;border:1px solid #8f7450}.bottle-label em{display:block;font-family:Georgia,serif;font-style:normal;font-weight:900;letter-spacing:.04em}.bottle-label small{display:block;margin-top:.25rem;font-size:.75rem;font-weight:800}.pair-stage.oil-left .bottle{left:-20vw}.pair-stage.oil-right .bottle{right:-20vw}.pair-stage.oil-left .egg{right:-24vw}.pair-stage.oil-right .egg{left:-24vw}.pair-stage.run.oil-left .bottle{animation:bottleFromLeft 1.55s cubic-bezier(.16,.74,.2,1) forwards}.pair-stage.run.oil-right .bottle{animation:bottleFromRight 1.55s cubic-bezier(.16,.74,.2,1) forwards}.pair-stage.run.oil-left .egg{animation:rollFromRight 2.2s cubic-bezier(.13,.72,.2,1) forwards}.pair-stage.run.oil-right .egg{animation:rollFromLeft 2.2s cubic-bezier(.13,.72,.2,1) forwards}@keyframes bottleFromLeft{0%{left:-20vw;opacity:0;transform:translateY(12vh) rotate(-20deg)}100%{left:23%;opacity:1;transform:translateY(0) rotate(0)}}@keyframes bottleFromRight{0%{right:-20vw;opacity:0;transform:translateY(12vh) rotate(20deg)}100%{right:23%;opacity:1;transform:translateY(0) rotate(0)}}@keyframes rollFromRight{0%{right:-24vw;opacity:0;transform:rotate(0) translateY(0)}10%{opacity:1}22%{transform:rotate(-240deg) translateY(-6px)}46%{transform:rotate(-600deg) translateY(2px)}70%{transform:rotate(-960deg) translateY(-4px)}100%{right:36%;opacity:1;transform:rotate(-1440deg) translateY(0)}}@keyframes rollFromLeft{0%{left:-24vw;opacity:0;transform:rotate(0) translateY(0)}10%{opacity:1}22%{transform:rotate(240deg) translateY(-6px)}46%{transform:rotate(600deg) translateY(2px)}70%{transform:rotate(960deg) translateY(-4px)}100%{left:36%;opacity:1;transform:rotate(1440deg) translateY(0)}}.meet{position:absolute;z-index:11;left:50%;top:45%;width:110px;height:110px;border-radius:50%;border:2px solid rgba(255,255,255,.75);transform:translate(-50%,-50%) scale(.3);opacity:0}.pair-stage.meeting .meet{animation:meetPulse .8s ease forwards}@keyframes meetPulse{0%{opacity:0;transform:translate(-50%,-50%) scale(.3)}45%{opacity:1;transform:translate(-50%,-50%) scale(1.4)}100%{opacity:0;transform:translate(-50%,-50%) scale(2)}}.pair-stage.meeting .egg,.pair-stage.meeting .bottle{opacity:0!important}.pour{position:absolute;z-index:12;left:50%;top:43%;width:8px;height:0;border-radius:999px;background:linear-gradient(180deg,#ffe39a,#b96b1a);box-shadow:0 0 15px rgba(255,200,70,.65);transform:translateX(-50%);opacity:0}.pair-stage.pouring .pour{animation:pour 1.2s ease forwards}@keyframes pour{0%{height:0;opacity:0}15%{opacity:1}70%{height:24vh;opacity:1}100%{height:0;opacity:0}}.caption{position:absolute;z-index:20;left:5vw;bottom:7vh;width:min(600px,88vw);padding:1.2rem 1.35rem;border-radius:18px;background:rgba(14,13,11,.84);border:1px solid rgba(255,255,255,.18);backdrop-filter:blur(15px);box-shadow:0 18px 44px rgba(0,0,0,.35)}.caption h3{font-size:clamp(1.7rem,3.5vw,2.8rem);line-height:1.05;letter-spacing:-.04em;margin:.3rem 0 .6rem}.caption p{font-size:clamp(.96rem,1.4vw,1.05rem);line-height:1.72;margin:0;color:#ded6ca}.result{position:absolute;z-index:22;right:5vw;top:18vh;width:min(370px,34vw);padding:1.25rem;border-radius:18px;background:rgba(255,255,255,.95);color:#161718;box-shadow:0 24px 62px rgba(0,0,0,.36);opacity:0;transform:translateY(22px)}.pair-stage.result-on .result{opacity:1;transform:none;transition:.55s}.result .mark{font-size:3rem;font-weight:950;line-height:.8;color:var(--warn)}.result.good .mark{color:var(--good)}.result h4{font-size:clamp(1.35rem,2vw,1.85rem);margin:.7rem 0 .45rem}.result p{margin:0;color:#4c5052;line-height:1.62}.result .tag{display:block;margin-top:.7rem;color:#8b631b;font-size:.78rem;font-weight:900}.pair-step{height:100svh;position:relative;z-index:30;pointer-events:none}.final{padding:11vh 5vw;background:#eae1d3}.final-inner{max-width:1100px;margin:auto;display:grid;grid-template-columns:1.05fr .95fr;gap:34px;align-items:center}.final img{width:100%;border-radius:24px;box-shadow:0 18px 45px rgba(0,0,0,.14)}.final h2{font-size:clamp(2.5rem,5vw,5.2rem);line-height:1;letter-spacing:-.05em;margin:.45rem 0 1rem}.final p{font-size:1.04rem;line-height:1.85;color:#4d5451}.source{font-size:.8rem;color:#69706d;margin-top:1rem}.chips{display:flex;gap:10px;flex-wrap:wrap;margin:1.4rem 0}.chip{padding:.75rem 1rem;border-radius:999px;color:#fff;font-weight:850}.chip.good{background:#627d55}.chip.warn{background:#97483f}@media(max-width:820px){.pair-head{left:6vw;right:6vw;width:auto}.pair-head h2{font-size:2.1rem}.pair-head p{font-size:.9rem}.pan{width:112vw;height:36vh;bottom:0}.bottle{width:22vw;height:29vh;top:31%}.egg{width:25vw;top:44%}.result{left:5vw;right:5vw;top:auto;bottom:31vh;width:auto}.caption{left:5vw;right:5vw;width:auto;bottom:5vh}.pair-stage.run.oil-left .egg{animation-name:rollFromRightM}.pair-stage.run.oil-right .egg{animation-name:rollFromLeftM}.pair-stage.run.oil-left .bottle{animation-name:bottleFromLeftM}.pair-stage.run.oil-right .bottle{animation-name:bottleFromRightM}@keyframes rollFromRightM{0%{right:-34vw;opacity:0;transform:rotate(0)}10%{opacity:1}50%{transform:rotate(-720deg) translateY(-4px)}100%{right:24%;opacity:1;transform:rotate(-1440deg)}}@keyframes rollFromLeftM{0%{left:-34vw;opacity:0;transform:rotate(0)}10%{opacity:1}50%{transform:rotate(720deg) translateY(-4px)}100%{left:24%;opacity:1;transform:rotate(1440deg)}}@keyframes bottleFromLeftM{0%{left:-30vw;opacity:0}100%{left:10%;opacity:1}}@keyframes bottleFromRightM{0%{right:-30vw;opacity:0}100%{right:10%;opacity:1}}.final-inner{grid-template-columns:1fr}.story-card{width:90vw;padding:20px}.hero-copy{left:7vw;right:7vw;width:auto}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}</style></head><body><div class="progress"></div><section class="hero"><div class="sticky"><img src="assets/hero-egg-oil.png" alt="달걀과 기름, 프라이팬의 달걀 프라이"><div class="shade"></div><div class="hero-copy"><div class="kicker">VISUAL NEWS · EGG × OIL</div><h1>자주 먹는 달걀 프라이,<br>기름과 궁합이 있다는데</h1><p>달걀은 같아도 어떤 기름을 쓰느냐에 따라 지방의 구성이 달라집니다. 달걀 여섯 알이 데굴데굴 굴러오고, 여섯 가지 오일이 왼쪽과 오른쪽에서 번갈아 등장합니다.</p></div></div></section><section class="story"><div class="sticky"><img class="story-bg" src="assets/coconut.png" alt="코코넛오일과 달걀 프라이"><div class="story-shade"></div><article class="story-card"><div class="eyebrow">THE TWIST · COCONUT OIL</div><h2>건강식 이미지의 <strong>코코넛오일</strong>, 달걀 프라이에는?</h2><p>심장 전문의들은 달걀을 부칠 때 코코넛오일이나 팜유를 자주 사용하는 방식에는 주의가 필요하다고 설명합니다. 코코넛오일은 지방의 80~90%가 포화지방으로 구성돼 있기 때문입니다.</p><p>포화지방을 많이 섭취하면 LDL 콜레스테롤이 증가할 수 있습니다. 한 번의 조리가 곧 질환으로 이어진다는 뜻은 아니지만, 반복되는 식습관에서는 어떤 기름을 선택하는지가 중요해집니다.</p></article></div></section><section class="story"><div class="sticky"><img class="story-bg" src="assets/artery.png" alt="혈관과 콜레스테롤 이미지"><div class="story-shade"></div><article class="story-card"><div class="eyebrow">SATURATED FAT · LDL</div><h2>핵심은 <strong>LDL 콜레스테롤</strong></h2><p>코코넛오일과 팜유는 포화지방 함량이 높은 열대성 기름입니다. 미국심장협회는 포화지방을 불포화지방으로 대체하는 식습관을 권고합니다.</p><p>반대로 올리브오일, 카놀라유, 해바라기유, 홍화씨유처럼 불포화지방 비중이 높은 식물성 기름은 포화지방이 많은 기름을 대신하는 선택지로 거론됩니다.</p></article></div></section><section class="story"><div class="sticky"><img class="story-bg" src="assets/research.png" alt="연구 자료 이미지"><div class="story-shade"></div><article class="story-card"><div class="eyebrow">CIRCULATION · 2020</div><h2><strong>17개 임상시험, 730명</strong></h2><p>2020년 국제학술지 Circulation에 실린 메타분석은 17개 임상시험, 730명의 자료를 종합했습니다. 코코넛오일 섭취군의 LDL 콜레스테롤은 비열대성 식물성기름 섭취군보다 평균 약 10.47mg/dL 높았습니다.</p><p>이제 같은 달걀에 여섯 가지 기름을 차례로 만나게 해보겠습니다.</p></article></div></section><section class="pairs"><div class="pair-stage oil-left" id="pairStage"><div class="pair-head"><div class="kicker">SIX EGGS · SIX OILS</div><h2>달걀은 데굴데굴,<br>오일은 좌우에서</h2><p>각 장면에서 달걀이 반대편에서 굴러와 오일과 중앙에서 만납니다. 둘이 만나면 프라이팬 속 달걀 프라이로 바뀝니다.</p></div><div class="scene-count" id="sceneCount">01 / 06</div><div class="pan"><img id="panImg" src="assets/fry-olive.webp" alt="프라이팬의 달걀 프라이"></div><img class="egg" src="assets/egg.png" alt="데굴데굴 굴러오는 달걀"><div class="bottle"><div class="bottle-label"><em id="engLabel">OLIVE</em><small id="korLabel">올리브오일</small></div></div><i class="meet"></i><i class="pour"></i><div class="caption"><div class="kicker" id="sceneKicker">SCENE 1</div><h3 id="sceneTitle">올리브오일과 첫 번째 달걀</h3><p id="sceneText">달걀이 오른쪽에서 데굴데굴 굴러옵니다. 왼쪽에서는 올리브오일이 들어옵니다.</p></div><aside class="result good" id="result"><div class="mark" id="resultMark">○</div><h4 id="resultTitle">올리브오일</h4><p id="resultText">불포화지방을 섭취하는 대표적인 선택지입니다.</p><span class="tag" id="resultTag">상대적으로 나은 선택</span></aside></div><div class="pair-step" data-i="0"></div><div class="pair-step" data-i="1"></div><div class="pair-step" data-i="2"></div><div class="pair-step" data-i="3"></div><div class="pair-step" data-i="4"></div><div class="pair-step" data-i="5"></div></section><section class="story"><div class="sticky"><img class="story-bg" src="assets/oils.png" alt="여러 종류의 식용유"><div class="story-shade"></div><article class="story-card"><div class="eyebrow">THEN, WHICH OIL?</div><h2>그렇다면 어떤 기름을?</h2><p>심장내과 전문의 인터뷰에서는 카놀라유, 해바라기유, 홍화씨유가 대안으로 언급됐습니다. 엑스트라 버진 올리브오일과 아보카도오일 역시 불포화지방을 섭취하는 선택지로 거론됩니다.</p><p>반면 코코넛오일과 팜유는 포화지방 비율이 높아 자주 쓰는 조리유로는 주의가 필요합니다.</p></article></div></section><section class="final"><div class="final-inner"><img src="assets/balanced.png" alt="과일과 요구르트가 포함된 균형 잡힌 아침 식사"><div><div class="kicker">BEYOND THE OIL</div><h2>기름만 바꾸면 끝일까?</h2><p>기름 종류만 바꾸는 것으로 콜레스테롤 위험에서 완전히 벗어나는 것은 아닙니다. 전문가들은 달걀 요리를 매일 반복하기보다 베리류, 사과, 파인애플, 저지방 요구르트, 그래놀라 등을 곁들여 아침 식사의 영양 균형을 맞추는 것도 중요하다고 설명합니다.</p><p>특정 건강식품을 과잉 섭취하는 것보다 전체 식단에서 포화지방을 줄이고, 불포화지방을 적당량 섭취하는 습관이 더 중요합니다.</p><div class="chips"><span class="chip good">올리브·카놀라·해바라기·홍화씨유</span><span class="chip warn">팜유·코코넛오일 주의</span></div><p class="source">자료: Circulation(2020), American Heart Association, 심장 전문의 인터뷰. 일반 건강 정보이며 개인의 진단이나 치료를 대신하지 않습니다.</p></div></div></section><script>const data=[{eng:'OLIVE',kor:'올리브오일',img:'assets/fry-olive.webp',mark:'○',good:true,title:'올리브오일과 첫 번째 달걀',scene:'달걀이 오른쪽에서 데굴데굴 굴러옵니다. 왼쪽에서는 올리브오일이 들어옵니다.',text:'불포화지방을 섭취하는 대표적인 선택지입니다.',tag:'상대적으로 나은 선택'},{eng:'CANOLA',kor:'카놀라유',img:'assets/fry-canola.webp',mark:'○',good:true,title:'카놀라유와 두 번째 달걀',scene:'이번에는 오일이 오른쪽에서 들어오고, 달걀이 왼쪽에서 빙글빙글 굴러옵니다.',text:'포화지방이 낮고 불포화지방 비중이 높은 편입니다.',tag:'대체 선택지'},{eng:'SUNFLOWER',kor:'해바라기유',img:'assets/fry-sunflower.png',mark:'○',good:true,title:'해바라기유와 세 번째 달걀',scene:'다시 왼쪽에서 오일이 등장합니다. 달걀은 반대편에서 데굴데굴 중앙으로 향합니다.',text:'비열대성 식물성 기름으로 불포화지방 비중이 높은 편입니다.',tag:'대체 선택지'},{eng:'SAFFLOWER',kor:'홍화씨유',img:'assets/fry-safflower.png',mark:'○',good:true,title:'홍화씨유와 네 번째 달걀',scene:'오일과 달걀이 방향을 바꿔 다시 중앙에서 만납니다.',text:'불포화지방이 많은 식물성 기름입니다.',tag:'대체 선택지'},{eng:'PALM',kor:'팜유',img:'assets/fry-palm.webp',mark:'△',good:false,title:'팜유와 다섯 번째 달걀',scene:'다섯 번째부터 분위기가 달라집니다. 팜유는 포화지방 비율이 높은 기름입니다.',text:'코코넛오일과 함께 자주 쓰는 조리유로는 주의가 필요합니다.',tag:'주의가 필요한 선택'},{eng:'COCONUT',kor:'코코넛오일',img:'assets/fry-coconut.png',mark:'!',good:false,title:'마지막은 코코넛오일',scene:'마지막 달걀이 데굴데굴 굴러옵니다. 건강식 이미지가 강한 코코넛오일과 만납니다.',text:'지방의 80~90%가 포화지방으로 구성돼 있습니다.',tag:'이번 비교의 핵심 주의 지점'}];const stage=document.getElementById('pairStage'),steps=[...document.querySelectorAll('.pair-step')],count=document.getElementById('sceneCount'),panImg=document.getElementById('panImg'),engLabel=document.getElementById('engLabel'),korLabel=document.getElementById('korLabel'),sceneKicker=document.getElementById('sceneKicker'),sceneTitle=document.getElementById('sceneTitle'),sceneText=document.getElementById('sceneText'),result=document.getElementById('result'),resultMark=document.getElementById('resultMark'),resultTitle=document.getElementById('resultTitle'),resultText=document.getElementById('resultText'),resultTag=document.getElementById('resultTag');let timers=[];function runScene(i){const d=data[i];timers.forEach(clearTimeout);timers=[];stage.classList.remove('run','meeting','pouring','frying','result-on','oil-left','oil-right');stage.classList.add(i%2===0?'oil-left':'oil-right');count.textContent=String(i+1).padStart(2,'0')+' / 06';engLabel.textContent=d.eng;korLabel.textContent=d.kor;sceneKicker.textContent='SCENE '+(i+1);sceneTitle.textContent=d.title;sceneText.textContent=d.scene;result.classList.toggle('good',d.good);resultMark.textContent=d.mark;resultTitle.textContent=d.kor;resultText.textContent=d.text;resultTag.textContent=d.tag;panImg.src=d.img;panImg.alt=d.kor+'로 부친 달걀 프라이';void stage.offsetWidth;stage.classList.add('run');timers.push(setTimeout(()=>stage.classList.add('meeting'),2050));timers.push(setTimeout(()=>{stage.classList.remove('meeting');stage.classList.add('pouring')},2700));timers.push(setTimeout(()=>stage.classList.add('frying'),3550));timers.push(setTimeout(()=>stage.classList.add('result-on'),4250))}const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting)runScene(+e.target.dataset.i)}),{rootMargin:'-48% 0px -48% 0px',threshold:0});steps.forEach(s=>io.observe(s));const cards=[...document.querySelectorAll('.story-card')];function render(){const vh=innerHeight;cards.forEach(c=>{const r=c.closest('.story').getBoundingClientRect();let p=(vh-r.top)/(r.height+vh);p=Math.max(0,Math.min(1,p));c.style.bottom=(-38+122*p)+'vh';c.style.opacity=Math.min(1,Math.max(0,(p-.08)*6))*Math.min(1,Math.max(0,(.94-p)*6))});const d=document.documentElement,m=d.scrollHeight-d.clientHeight;document.querySelector('.progress').style.width=(m?d.scrollTop/m*100:0)+'%'}addEventListener('scroll',render,{passive:true});addEventListener('resize',render);render();runScene(0);if(window.parent!==window){const send=()=>parent.postMessage({type:'egg-oil-story-height',height:document.documentElement.scrollHeight},'*');new ResizeObserver(send).observe(document.documentElement);addEventListener('load',send)}</script></body></html>
