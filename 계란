
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>달걀 6개, 오일 6개</title>
<meta name="description" content="달걀 6개와 오일 6개로 만드는 인터랙티브 스크롤 기사">
<style>
:root{--ink:#141619;--paper:#f6f1e8;--card:#fffefb;--line:#dfd8cc;--yolk:#f7ab00;--bad:#b3362f;--good:#316b55;--muted:#6d706f;--shadow:0 20px 60px rgba(20,18,15,.16);--max:1180px}
*{box-sizing:border-box}
html{scroll-behavior:smooth;background:var(--paper)}
body{margin:0;color:var(--ink);background:var(--paper);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans KR","Apple SD Gothic Neo",Arial,sans-serif;line-height:1.65}
img{max-width:100%;display:block}
button{font:inherit}
a{color:inherit}
.progress{position:fixed;z-index:1000;left:0;top:0;width:100%;height:4px;background:rgba(255,255,255,.5)}
.progress i{display:block;width:0;height:100%;background:var(--yolk)}
.hero{min-height:100svh;position:relative;display:grid;place-items:center;overflow:hidden;background:#101214;color:white}
.hero-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:brightness(.72) saturate(.9)}
.hero:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.08),rgba(0,0,0,.78))}
.hero-copy{position:relative;z-index:2;width:min(calc(100% - 36px),var(--max));padding:100px 0 70px;align-self:end}
.eyebrow{display:inline-block;padding:7px 11px;border:1px solid rgba(255,255,255,.3);border-radius:999px;font-size:12px;font-weight:800;letter-spacing:.08em;background:rgba(0,0,0,.18)}
.hero h1{font-size:clamp(46px,8vw,104px);line-height:.93;letter-spacing:-.06em;margin:18px 0 22px;max-width:980px}
.hero p{max-width:720px;font-size:clamp(18px,2.1vw,25px);margin:0;color:rgba(255,255,255,.9)}
.intro{padding:100px 20px}
.intro-inner{max-width:760px;margin:auto;font-size:clamp(18px,2vw,22px)}
.intro-inner p{margin:0 0 1.45em}
.question{font-size:clamp(34px,5vw,66px);font-weight:900;line-height:1.06;letter-spacing:-.045em;margin:80px auto;max-width:980px;text-align:center}
.scrolly{position:relative}
.sticky{position:sticky;top:0;height:100svh;overflow:hidden;background:#111417}
.stage{position:absolute;inset:0}
.stage img{width:100%;height:100%;object-fit:cover;transition:opacity .35s ease,transform .5s ease}
.stage .shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.1),rgba(0,0,0,.35))}
.steps{position:relative;z-index:5;width:min(calc(100% - 28px),900px);margin:0 auto;padding:20vh 0 25vh}
.step-card{width:min(520px,92%);margin:0 0 75vh auto;background:rgba(255,255,255,.96);border:1px solid rgba(0,0,0,.08);border-radius:22px;padding:24px 25px;box-shadow:var(--shadow);backdrop-filter:blur(10px)}
.step-card.left{margin-left:0;margin-right:auto}
.step-card.center{margin-left:auto;margin-right:auto}
.step-card:last-child{margin-bottom:5vh}
.step-card .n{font-size:11px;letter-spacing:.08em;font-weight:900;color:#8a7f6a}
.step-card h2{font-size:clamp(26px,3.2vw,42px);line-height:1.07;letter-spacing:-.035em;margin:8px 0 12px}
.step-card p{font-size:16px;color:#4f5457;margin:0}
.step-card b{color:var(--bad)}
.experiment-wrap{background:#15181b;color:#fff;padding:95px 20px}
.experiment{width:min(100%,var(--max));margin:auto}
.experiment-head{display:grid;grid-template-columns:1.15fr .85fr;gap:28px;align-items:end;margin-bottom:30px}
.experiment-head h2{font-size:clamp(40px,6vw,76px);line-height:.98;letter-spacing:-.05em;margin:0}
.experiment-head p{color:#b9c0c6;margin:0}
.lab{border:1px solid rgba(255,255,255,.12);background:#1d2125;border-radius:30px;padding:clamp(18px,3vw,32px);box-shadow:var(--shadow)}
.lab-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.panel{border:1px solid rgba(255,255,255,.11);border-radius:22px;padding:20px;background:#171a1d;min-height:440px}
.panel h3{font-size:18px;margin:0 0 14px}
.egg-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.egg-btn{position:relative;border:1px solid rgba(255,255,255,.1);border-radius:18px;background:#23282d;cursor:pointer;padding:12px;min-height:160px;overflow:hidden}
.egg-btn img{width:100%;height:120px;object-fit:contain;filter:drop-shadow(0 12px 18px rgba(0,0,0,.25))}
.egg-btn span{position:absolute;left:10px;bottom:8px;font-size:12px;color:#cbd1d5}
.egg-btn[aria-pressed="true"]{outline:3px solid var(--yolk);background:#2a2b24}
.oil-scene{position:relative;border-radius:18px;overflow:hidden;background:#080a0b;min-height:330px}
.oil-scene img{width:100%;height:330px;object-fit:cover}
.oil-hotspots{position:absolute;inset:0;display:grid;grid-template-columns:repeat(6,1fr)}
.oil-hit{border:0;background:transparent;cursor:pointer;position:relative}
.oil-hit span{position:absolute;left:50%;bottom:8px;transform:translateX(-50%);background:rgba(0,0,0,.72);padding:5px 7px;border-radius:8px;font-size:10px;color:#fff;white-space:nowrap}
.oil-hit[aria-pressed="true"]{box-shadow:inset 0 0 0 4px var(--yolk)}
.selection{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px;color:#bac2c8;font-size:13px}
.selection strong{color:white}
.fry-box{margin-top:18px;display:grid;grid-template-columns:1fr 340px;gap:18px}
.pan{position:relative;border-radius:22px;overflow:hidden;background:#d9d9d9;min-height:470px}
.pan img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.pan .fried{opacity:0;transform:scale(.84);transition:opacity .7s ease,transform .8s cubic-bezier(.2,.8,.2,1)}
.pan.cooking .fried{opacity:1;transform:scale(1)}
.pan.cooking .raw{opacity:0}
.sizzle{position:absolute;inset:0;pointer-events:none;opacity:0}
.pan.cooking .sizzle{opacity:1}
.sizzle i{position:absolute;width:9px;height:9px;border-radius:50%;background:rgba(255,255,255,.75);animation:pop 1.2s infinite}
.sizzle i:nth-child(1){left:34%;top:48%;animation-delay:.1s}.sizzle i:nth-child(2){left:57%;top:57%;animation-delay:.35s}.sizzle i:nth-child(3){left:46%;top:38%;animation-delay:.7s}.sizzle i:nth-child(4){left:67%;top:46%;animation-delay:.55s}.sizzle i:nth-child(5){left:30%;top:62%;animation-delay:.9s}
@keyframes pop{0%,100%{transform:scale(.2);opacity:.15}50%{transform:scale(1.9);opacity:.8}}
.result{border:1px solid rgba(255,255,255,.11);border-radius:22px;padding:22px;background:#171a1d;display:flex;flex-direction:column;justify-content:space-between}
.result small{color:#9aa3aa}
.result h3{font-size:32px;line-height:1.05;margin:10px 0}
.result p{color:#c1c8cd;font-size:14px}
.meter{margin-top:18px}
.meter-line{height:10px;background:#333a40;border-radius:999px;overflow:hidden;margin-top:8px}
.meter-line i{display:block;height:100%;width:0;background:var(--yolk);border-radius:inherit;transition:width .5s ease}
.fry-btn{width:100%;margin-top:18px;padding:15px 18px;border:0;border-radius:14px;background:var(--yolk);color:#111;font-weight:900;cursor:pointer}
.fry-btn:disabled{opacity:.35;cursor:not-allowed}
.reset{margin-top:10px;width:100%;padding:12px;border:1px solid rgba(255,255,255,.18);border-radius:12px;background:transparent;color:white;cursor:pointer}
.evidence{padding:110px 20px;background:#fffdf8}
.evidence-inner{max-width:980px;margin:auto}
.evidence h2{font-size:clamp(38px,5vw,64px);line-height:1;letter-spacing:-.04em;margin:0 0 35px}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.stat{border:1px solid var(--line);border-radius:22px;padding:24px;background:#fff}
.stat strong{font-size:clamp(38px,5vw,62px);line-height:1;display:block}
.stat span{font-size:13px;color:var(--muted);display:block;margin-top:10px}
.final{padding:100px 20px;background:#efe7d8}
.final-inner{width:min(100%,var(--max));margin:auto;display:grid;grid-template-columns:1.1fr .9fr;gap:30px;align-items:center}
.final img{border-radius:26px;box-shadow:var(--shadow)}
.final h2{font-size:clamp(38px,5vw,62px);line-height:1.03;letter-spacing:-.04em;margin:0 0 18px}
.final p{color:#555c59;font-size:17px}
.sources{padding:60px 20px 80px;background:#fffdf8}
.sources-inner{max-width:900px;margin:auto;font-size:13px;color:#61676b}
.sources h3{color:#111;font-size:18px}
.sources ol{padding-left:20px}
.sources li{margin:8px 0}
@media(max-width:900px){
  .experiment-head,.lab-grid,.fry-box,.final-inner{grid-template-columns:1fr}
  .stats{grid-template-columns:1fr}
  .panel{min-height:auto}
  .step-card{margin-left:auto;margin-right:auto}
  .oil-hit span{display:none}
}
@media(max-width:560px){
  .egg-grid{grid-template-columns:repeat(2,1fr)}
  .steps{padding-top:15vh}
  .step-card{margin-bottom:68vh;padding:20px}
  .experiment-wrap{padding-left:12px;padding-right:12px}
  .lab{padding:12px}
}
</style>
</head>
<body>
<div class="progress"><i id="progressBar"></i></div>

<section class="hero">
  <img class="hero-bg" src="assets/crack-egg.png" alt="프라이팬에 달걀을 깨는 모습">
  <div class="hero-copy">
    <span class="eyebrow">INTERACTIVE HEALTH STORY</span>
    <h1>달걀 6개.<br>오일 6개.</h1>
    <p>같은 달걀 프라이도 어떤 기름을 반복해서 쓰느냐에 따라 지방의 구성이 달라집니다. 직접 하나씩 골라 부쳐보세요.</p>
  </div>
</section>

<section class="intro">
  <div class="intro-inner">
    <p>여러분은 달걀 프라이를 좋아하시나요? 아침으로 달걀 두 알. 든든하고 맛있죠.</p>
    <p>그런데 건강에 좋다고 알려진 기름 가운데, 달걀을 부칠 때 자주 쓰는 조리유로는 주의가 필요한 것이 있습니다. 바로 <b>코코넛오일</b>입니다.</p>
  </div>
  <div class="question">어떤 기름이 가장<br>심혈관 건강에 불리할까요?</div>
</section>

<section class="scrolly" id="story">
  <div class="sticky">
    <div class="stage">
      <img id="storyImage" src="assets/egg-sunny.png" alt="">
      <div class="shade"></div>
    </div>
  </div>
  <div class="steps">
    <article class="step-card left" data-image="assets/egg-sunny.png">
      <span class="n">01 / BREAKFAST</span>
      <h2>달걀 프라이는 단순합니다.</h2>
      <p>달걀 하나, 팬 하나, 그리고 기름 한 숟갈. 문제는 이 마지막 한 숟갈의 지방 구성이 매일 반복될 때입니다.</p>
    </article>
    <article class="step-card" data-image="assets/coconut-oil-egg.png">
      <span class="n">02 / COCONUT OIL</span>
      <h2>코코넛오일은 <b>포화지방이 매우 많습니다.</b></h2>
      <p>건강식 이미지와 별개로, 코코넛오일의 지방은 대부분 포화지방으로 이뤄져 있습니다. 심혈관 건강 관점에서는 이를 불포화지방이 많은 식물성 기름으로 대체하는 것이 권고됩니다.</p>
    </article>
    <article class="step-card left" data-image="assets/artery.png">
      <span class="n">03 / LDL</span>
      <h2>핵심은 LDL 콜레스테롤입니다.</h2>
      <p>포화지방 섭취가 많아지면 LDL 콜레스테롤이 상승할 수 있고, 장기적으로 죽상경화성 심혈관질환 위험과 연결됩니다.</p>
    </article>
    <article class="step-card" data-image="assets/research-desk.png">
      <span class="n">04 / EVIDENCE</span>
      <h2>2020년 메타분석에서도 차이가 관찰됐습니다.</h2>
      <p>17개 임상시험, 730명의 자료를 종합했을 때 코코넛오일 섭취군의 LDL은 비열대성 식물성기름군보다 평균 10.47mg/dL 높았습니다.</p>
    </article>
    <article class="step-card center" data-image="assets/oils.png">
      <span class="n">05 / YOUR TURN</span>
      <h2>이제 직접 6개의 달걀과 6개의 오일을 골라보세요.</h2>
      <p>아래 실험에서 달걀과 기름을 하나씩 선택한 뒤 프라이 버튼을 눌러 결과를 확인할 수 있습니다.</p>
    </article>
  </div>
</section>

<section class="experiment-wrap">
  <div class="experiment">
    <div class="experiment-head">
      <h2>6 EGGS<br>6 OILS</h2>
      <p>달걀 하나와 오일 하나를 선택하세요. 달걀 번호는 시각적 선택이고, 심혈관 건강 평가는 선택한 오일의 지방 구성에 따라 달라집니다.</p>
    </div>

    <div class="lab">
      <div class="lab-grid">
        <div class="panel">
          <h3>1. 달걀 하나를 고르세요</h3>
          <div class="egg-grid" id="eggGrid"></div>
          <div class="selection">선택한 달걀: <strong id="eggChoice">없음</strong></div>
        </div>

        <div class="panel">
          <h3>2. 오일 하나를 고르세요</h3>
          <div class="oil-scene">
            <img src="assets/oils.png" alt="6개의 오일 병">
            <div class="oil-hotspots">
              <button class="oil-hit" data-oil="olive" aria-pressed="false"><span>올리브</span></button>
              <button class="oil-hit" data-oil="canola" aria-pressed="false"><span>카놀라</span></button>
              <button class="oil-hit" data-oil="sunflower" aria-pressed="false"><span>해바라기</span></button>
              <button class="oil-hit" data-oil="safflower" aria-pressed="false"><span>홍화씨</span></button>
              <button class="oil-hit" data-oil="palm" aria-pressed="false"><span>팜</span></button>
              <button class="oil-hit" data-oil="coconut" aria-pressed="false"><span>코코넛</span></button>
            </div>
          </div>
          <div class="selection">선택한 오일: <strong id="oilChoice">없음</strong></div>
        </div>
      </div>

      <div class="fry-box">
        <div class="pan" id="pan">
          <img src="assets/crack-egg.png" class="raw" alt="달걀을 팬에 깨는 모습">
          <img src="assets/egg-runny.png" class="fried" id="friedEgg" alt="완성된 달걀 프라이">
          <div class="sizzle"><i></i><i></i><i></i><i></i><i></i></div>
        </div>
        <aside class="result">
          <div>
            <small id="resultKicker">RESULT</small>
            <h3 id="resultTitle">달걀과 오일을 선택하세요</h3>
            <p id="resultText">선택이 끝나면 조리 버튼이 활성화됩니다.</p>
            <div class="meter">
              <small>포화지방 부담</small>
              <div class="meter-line"><i id="riskBar"></i></div>
            </div>
          </div>
          <div>
            <button id="fryBtn" class="fry-btn" disabled>달걀 프라이 만들기</button>
            <button id="resetBtn" class="reset">다시 고르기</button>
          </div>
        </aside>
      </div>
    </div>
  </div>
</section>

<section class="evidence">
  <div class="evidence-inner">
    <h2>숫자로 보면 더 선명합니다.</h2>
    <div class="stats">
      <div class="stat"><strong>+10.47</strong><span>mg/dL - 코코넛오일군의 LDL이 비열대성 식물성기름군보다 높았던 평균 차이</span></div>
      <div class="stat"><strong>17</strong><span>분석에 포함된 임상시험 수</span></div>
      <div class="stat"><strong>730</strong><span>분석에 포함된 총 참여자 수</span></div>
    </div>
  </div>
</section>

<section class="final">
  <div class="final-inner">
    <img src="assets/balanced-breakfast.png" alt="과일과 요구르트, 달걀이 놓인 균형 잡힌 아침식사">
    <div>
      <h2>한 가지 기름보다 중요한 것은 전체 식단입니다.</h2>
      <p>기름 종류만 바꾼다고 모든 위험이 사라지지는 않습니다. 포화지방을 전체적으로 줄이고, 불포화지방을 적당히 선택하며, 과일과 통곡물, 저지방 유제품 등 다양한 식품을 함께 먹는 방향이 더 중요합니다.</p>
    </div>
  </div>
</section>

<section class="sources">
  <div class="sources-inner">
    <h3>근거 및 참고</h3>
    <ol>
      <li>Parade, cardiologist interview on cooking oils for eggs.</li>
      <li>Neelakantan N, Seah JYH, van Dam RM. The Effect of Coconut Oil Consumption on Cardiovascular Risk Factors. Circulation. 2020;141:803-814.</li>
      <li>American Heart Association guidance on saturated fats and healthy cooking oils.</li>
    </ol>
  </div>
</section>

<script>
const storyCards=[...document.querySelectorAll(".step-card")];
const storyImage=document.getElementById("storyImage");
const storyObserver=new IntersectionObserver((entries)=>{
  entries.forEach(entry=>{
    if(entry.isIntersecting){
      const src=entry.target.dataset.image;
      storyImage.style.opacity=".25";
      storyImage.style.transform="scale(1.035)";
      setTimeout(()=>{storyImage.src=src;storyImage.style.opacity="1";storyImage.style.transform="scale(1)";},140);
    }
  });
},{rootMargin:"-42% 0px -42% 0px",threshold:0});
storyCards.forEach(c=>storyObserver.observe(c));

const eggGrid=document.getElementById("eggGrid");
for(let i=1;i<=6;i++){
  const b=document.createElement("button");
  b.className="egg-btn";b.dataset.egg=i;b.setAttribute("aria-pressed","false");
  b.innerHTML='<img src="assets/egg-isolated.png" alt="달걀 '+i+'"><span>EGG '+i+'</span>';
  eggGrid.appendChild(b);
}
const oils={
  olive:{name:"올리브오일",risk:24,title:"상대적으로 나은 선택",text:"단일불포화지방이 풍부한 액상 식물성 기름입니다.",img:"assets/egg-sunny.png"},
  canola:{name:"카놀라유",risk:18,title:"상대적으로 나은 선택",text:"포화지방이 낮고 불포화지방 비중이 높은 편입니다.",img:"assets/egg-runny.png"},
  sunflower:{name:"해바라기유",risk:21,title:"상대적으로 나은 선택",text:"불포화지방 중심의 비열대성 식물성 기름입니다.",img:"assets/egg-bubbling.png"},
  safflower:{name:"홍화씨유",risk:20,title:"상대적으로 나은 선택",text:"불포화지방이 많은 식물성 기름입니다.",img:"assets/egg-sunny.png"},
  palm:{name:"팜유",risk:74,title:"주의가 필요한 선택",text:"포화지방 비율이 높은 열대성 기름입니다. 자주 사용하는 조리유로는 주의가 필요합니다.",img:"assets/egg-crisp.png"},
  coconut:{name:"코코넛오일",risk:94,title:"이번 비교의 주의 1순위",text:"포화지방 비율이 매우 높습니다. 장기간 반복 섭취 관점에서 불포화지방이 많은 기름으로 대체하는 것이 더 유리합니다.",img:"assets/coconut-oil-egg.png"}
};
let selectedEgg=null,selectedOil=null;
const eggChoice=document.getElementById("eggChoice"),oilChoice=document.getElementById("oilChoice"),fryBtn=document.getElementById("fryBtn"),pan=document.getElementById("pan");
const resultTitle=document.getElementById("resultTitle"),resultText=document.getElementById("resultText"),riskBar=document.getElementById("riskBar"),friedEgg=document.getElementById("friedEgg");
document.querySelectorAll(".egg-btn").forEach(btn=>btn.addEventListener("click",()=>{
  document.querySelectorAll(".egg-btn").forEach(x=>x.setAttribute("aria-pressed","false"));
  btn.setAttribute("aria-pressed","true");selectedEgg=btn.dataset.egg;eggChoice.textContent="EGG "+selectedEgg;checkReady();
}));
document.querySelectorAll(".oil-hit").forEach(btn=>btn.addEventListener("click",()=>{
  document.querySelectorAll(".oil-hit").forEach(x=>x.setAttribute("aria-pressed","false"));
  btn.setAttribute("aria-pressed","true");selectedOil=btn.dataset.oil;oilChoice.textContent=oils[selectedOil].name;checkReady();
}));
function checkReady(){
  fryBtn.disabled=!(selectedEgg&&selectedOil);
  if(!fryBtn.disabled){resultTitle.textContent="조리 준비 완료";resultText.textContent="버튼을 눌러 결과를 확인하세요."}
}
fryBtn.addEventListener("click",()=>{
  const d=oils[selectedOil];
  friedEgg.src=d.img;
  pan.classList.remove("cooking");
  void pan.offsetWidth;
  pan.classList.add("cooking");
  setTimeout(()=>{resultTitle.textContent=d.title;resultText.textContent=d.name+" - "+d.text;riskBar.style.width=d.risk+"%";},450);
});
document.getElementById("resetBtn").addEventListener("click",()=>{
  selectedEgg=null;selectedOil=null;eggChoice.textContent="없음";oilChoice.textContent="없음";
  document.querySelectorAll(".egg-btn,.oil-hit").forEach(x=>x.setAttribute("aria-pressed","false"));
  fryBtn.disabled=true;pan.classList.remove("cooking");riskBar.style.width="0%";
  resultTitle.textContent="달걀과 오일을 선택하세요";resultText.textContent="선택이 끝나면 조리 버튼이 활성화됩니다.";
});
const pbar=document.getElementById("progressBar");
function setProgress(){const max=document.documentElement.scrollHeight-innerHeight;pbar.style.width=(max>0?scrollY/max*100:0)+"%"}
addEventListener("scroll",setProgress,{passive:true});setProgress();

const reportHeight=()=>{if(window.parent!==window){window.parent.postMessage({type:"egg-oil-story-height",height:document.documentElement.scrollHeight},"*")}};
new ResizeObserver(reportHeight).observe(document.documentElement);addEventListener("load",reportHeight);
</script>
</body>
</html>
